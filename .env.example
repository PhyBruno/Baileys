PORT=3000
DATABASE_URL=postgres://usuario:senha@localhost:5432/whatsapp_bridge

# Limite de tamanho do body JSON aceito pela API (formato aceito pelo
# express.json: número + unidade, ex "20mb"). O default do express (100kb)
# não é suficiente pra enviar imagem/documento em base64 via /messages.
JSON_BODY_LIMIT=20mb

# Só usada pelo docker-compose (o serviço "postgres" usa isso pra criar o
# banco, e a bridge monta o DATABASE_URL sozinha a partir daqui — não precisa
# duplicar). Ignorada se você não estiver usando o compose.
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Chave que a sua aplicação principal deve enviar no header x-api-key em toda
# chamada. Obrigatória — o servidor recusa subir sem ela. Gere algo forte, ex:
# openssl rand -hex 32
API_KEY=troque-por-uma-chave-forte

# Reconexão automática após queda de conexão (não se aplica a /disconnect
# solicitado manualmente via API, que nunca reconecta sozinho).
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_DELAY_MS=30000

# Quanto tempo (ms) POST /sessions/:id/messages espera por uma confirmação
# real de status (via evento messages.update: server_ack/delivery_ack/error)
# antes de responder. sendMessage() sozinho só confirma que a mensagem foi
# repassada ao servidor do WhatsApp, não que foi entregue — essa espera é o
# que permite a API devolver o resultado real (ou o motivo de uma falha) na
# mesma resposta HTTP. 0 desativa a espera (responde sem confirmar nada).
MESSAGE_STATUS_TIMEOUT_MS=8000

# Se uma sessão ficar em "connecting" (sem virar qr/connected/error) por mais
# tempo que isso, a bridge força a desconexão sozinha — igual a um
# /disconnect manual, ou seja, SEM tentar reconectar em seguida. Cobre o caso
# de o handshake travar sem nunca dar erro (comum atrás de firewall
# restritivo). 0 desativa esse watchdog.
CONNECTING_TIMEOUT_MS=45000
