{
  "info": {
    "name": "WhatsApp Bridge API (Baileys + Postgres)",
    "description": "Collection de exemplo para a bridge Baileys clonada em C:\\repos\\Baileys. Fluxo: connect -> qr -> messages / sendList / sendButtons -> disconnect -> connect -> delete. Ajuste as variaveis apiKey/sessionId/toNumber conforme seu ambiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "apiKey", "value": "troque-por-uma-chave-forte", "type": "string" },
    { "key": "sessionId", "value": "5511999999999", "type": "string" },
    { "key": "toNumber", "value": "5511988887777", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "List sessions",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["sessions"]
        }
      },
      "response": []
    },
    {
      "name": "Connect session",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/connect",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "connect"]
        }
      },
      "response": []
    },
    {
      "name": "Get QR code",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/qr",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "qr"]
        }
      },
      "response": []
    },
    {
      "name": "Send message",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"{{toNumber}}\",\n  \"message\": \"Ola! Mensagem de teste via Postman.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "messages"]
        }
      },
      "response": []
    },
    {
      "name": "Send image",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"{{toNumber}}\",\n  \"type\": \"image\",\n  \"mediaBase64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=\",\n  \"mimetype\": \"image/png\",\n  \"caption\": \"Imagem de teste via Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "messages"]
        }
      },
      "response": []
    },
    {
      "name": "Send document",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"{{toNumber}}\",\n  \"type\": \"document\",\n  \"mediaBase64\": \"Q29udGV1ZG8gZGUgZXhlbXBsbyBkbyBkb2N1bWVudG8gZGUgdGVzdGUu\",\n  \"mimetype\": \"text/plain\",\n  \"fileName\": \"exemplo.txt\",\n  \"caption\": \"Documento de teste via Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "messages"]
        }
      },
      "response": []
    },
    {
      "name": "Send list",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"{{toNumber}}\",\n  \"title\": \"📊 CONSULTAR DÉBITOS\",\n  \"description\": \"💰 *Vencidos:* R$ 116.31\\n\\n\\nℹ️ _+ 10 débitos não listados aqui._\",\n  \"footerText\": \"⬇️ Selecione a opção abaixo para visualizar ⬇️\",\n  \"buttonText\": \"Ver débitos\",\n  \"sections\": [\n    {\n      \"title\": \"Débitos Vencidos\",\n      \"rows\": [\n        {\n          \"title\": \"Doc: 22639 | P: 5\",\n          \"description\": \"R$ 46.36 - Venc: 19/10/2026\",\n          \"rowId\": \"1\"\n        },\n        {\n          \"title\": \"Doc: 25815 | P: 1\",\n          \"description\": \"R$ 69.95 - Venc: 19/10/2026\",\n          \"rowId\": \"2\"\n        }\n      ]\n    },\n    {\n      \"title\": \"Débitos A Vencer\",\n      \"rows\": [\n        {\n          \"title\": \"Doc: 22931 | P: 5\",\n          \"description\": \"R$ 29.97 - Venc: 31/10/2026\",\n          \"rowId\": \"3\"\n        },\n        {\n          \"title\": \"Doc: 26197 | P: 1\",\n          \"description\": \"R$ 83.33 - Venc: 15/11/2026\",\n          \"rowId\": \"4\"\n        },\n        {\n          \"title\": \"Doc: 25815 | P: 2\",\n          \"description\": \"R$ 69.95 - Venc: 18/11/2026\",\n          \"rowId\": \"5\"\n        },\n        {\n          \"title\": \"Doc: 22639 | P: 6\",\n          \"description\": \"R$ 46.37 - Venc: 18/11/2026\",\n          \"rowId\": \"6\"\n        }\n      ]\n    },\n    {\n      \"title\": \"Ações Adicionais\",\n      \"rows\": [\n        {\n          \"title\": \"📄 Todos em Aberto\",\n          \"description\": \"Gerar todos os débitos listados\",\n          \"rowId\": \"99\"\n        }\n      ]\n    },\n    {\n      \"title\": \"Atendimento\",\n      \"rows\": [\n        {\n          \"title\": \"🙋 Falar com Atendente\",\n          \"description\": \"Falar com um atendente humano\",\n          \"rowId\": \"atendente\"\n        }\n      ]\n    },\n    {\n      \"title\": \"Navegação\",\n      \"rows\": [\n        {\n          \"title\": \"⬅️ Voltar\",\n          \"description\": \"Retornar ao menu anterior\",\n          \"rowId\": \"0\"\n        }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/message/sendList",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "message", "sendList"]
        }
      },
      "response": []
    },
    {
      "name": "Send reply buttons",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"{{toNumber}}\",\n  \"title\": \"Confirma o pedido?\",\n  \"description\": \"Pedido 123 - R$ 46,36\",\n  \"footer\": \"Loja X\",\n  \"buttons\": [\n    {\n      \"type\": \"reply\",\n      \"displayText\": \"Sim\",\n      \"id\": \"sim\"\n    },\n    {\n      \"type\": \"reply\",\n      \"displayText\": \"Não\",\n      \"id\": \"nao\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/message/sendButtons",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "message", "sendButtons"]
        }
      },
      "response": []
    },
    {
      "name": "Send CTA buttons (url/copy)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"{{toNumber}}\",\n  \"title\": \"Fale com a gente\",\n  \"footer\": \"Loja X\",\n  \"buttons\": [\n    {\n      \"type\": \"url\",\n      \"displayText\": \"Abrir site\",\n      \"url\": \"https://exemplo.com\"\n    },\n    {\n      \"type\": \"copy\",\n      \"displayText\": \"Copiar código\",\n      \"copyCode\": \"ABC123\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/message/sendButtons",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "message", "sendButtons"]
        }
      },
      "response": []
    },
    {
      "name": "Send PIX button",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"{{toNumber}}\",\n  \"buttons\": [\n    {\n      \"type\": \"pix\",\n      \"currency\": \"BRL\",\n      \"name\": \"Loja X\",\n      \"keyType\": \"cpf\",\n      \"key\": \"12345678900\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/message/sendButtons",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "message", "sendButtons"]
        }
      },
      "response": []
    },
    {
      "name": "Disconnect session",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/disconnect",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "disconnect"]
        }
      },
      "response": []
    },
    {
      "name": "Delete session (logout)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}"]
        }
      },
      "response": []
    }
  ]
}
