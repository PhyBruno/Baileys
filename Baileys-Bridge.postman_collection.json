{
  "info": {
    "name": "WhatsApp Bridge API (Baileys + Postgres)",
    "description": "Collection de exemplo para a bridge Baileys clonada em C:\\repos\\Baileys. Fluxo: connect -> qr -> messages (texto/imagem/video/documento) / message/sendList / message/sendButtons (payload da Evolution API; cabecalho texto ou imagem, corpo, rodape e botoes opcionais) -> configuracoes, mensagens recebidas e webhooks -> disconnect -> connect -> delete. Ajuste as variaveis apiKey/sessionId/toNumber conforme seu ambiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "apiKey", "value": "troque-por-uma-chave-forte", "type": "string" },
    { "key": "sessionId", "value": "5511999999999", "type": "string" },
    { "key": "toNumber", "value": "5511988887777", "type": "string" },
    { "key": "webhookId", "value": "", "type": "string" }
  ],
  "item": [
