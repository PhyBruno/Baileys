    {
      "name": "Configurações",
      "description": "Configurações por instância. groupsIgnore (padrão true): mensagens de grupo não são gravadas nem repassadas.",
      "item": [
        {
          "name": "Get settings",
          "request": {
            "method": "GET",
            "header": [{"key": "x-api-key", "value": "{{apiKey}}"}],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/settings",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "settings"]
            }
          },
          "response": []
        },
        {
          "name": "Update settings (receber grupos)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"groupsIgnore\":  false\n}" },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/settings",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "settings"]
            }
          },
          "response": []
        }
      ]
